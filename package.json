    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/ai-anthropic": "0.21.1",
    "@tanstack/ai-client": "0.39.2",
    "@tanstack/ai-gemini": "0.37.2",
    "@tanstack/ai-ollama": "0.11.16",
    "@tanstack/ai-openai": "0.29.1",
    "@tanstack/ai-react": "0.30.3",
    "@tanstack/match-sorter-utils": "9.2.6",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-devtools": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/react-store": "0.11.2",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/store": "0.11.2",
    "better-auth": "^1.5.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
